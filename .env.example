# ==========================================
# ShipArrival - Environment Variables (.env)
# ==========================================
# Copia este archivo como '.env' en la raíz del proyecto y completa con tus credenciales reales.
# El archivo '.env' está ignorado por Git para proteger tu información.

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=false

# Discord Webhook Configuration
DISCORD_WEBHOOK_URL=
DISCORD_ENABLED=false

# Hapag-Lloyd (opcional)
# Ruta a Chrome si no está en una ubicación estándar. Use barras normales.
# HAPAG_LLOYD_CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe
# HAPAG_LLOYD_PROFILE_DIR=./data/hapag-chrome-profile
# HAPAG_LLOYD_DEBUG_PORT=0
# HAPAG_LLOYD_PAGE_TIMEOUT_SECONDS=90
# HAPAG_LLOYD_HEADLESS=false
