# ==========================================
# ShipArrival - Environment Variables (.env)
# ==========================================
# Copia este archivo como '.env' en la raíz del proyecto y completa con tus credenciales reales.
# El archivo '.env' está ignorado por Git para proteger tu información.

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=false

# Discord Webhook Configuration
DISCORD_WEBHOOK_URL=
DISCORD_ENABLED=false

# Hapag-Lloyd via ZenRows Fetch API
# Un B/L usa una solicitud para la lista y otra para detalles del primer contenedor.
# ZenRows factura créditos según el modo/configuración efectiva de cada respuesta.
# ZenRows Fetch API (Hapag-Lloyd)
ZENROWS_API_KEY=
ZENROWS_TIMEOUT_SECONDS=180

# Legacy Chrome configuration (unused by current Hapag-Lloyd adapter)
# HAPAG_LLOYD_CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe
# HAPAG_LLOYD_PROFILE_DIR=./data/hapag-chrome-profile
# HAPAG_LLOYD_DEBUG_PORT=0
# HAPAG_LLOYD_PAGE_TIMEOUT_SECONDS=90
# HAPAG_LLOYD_HEADLESS=false
